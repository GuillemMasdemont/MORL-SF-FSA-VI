     "text": [
      "mean |critic belief - empirical|  = 0.4916   (critic calibration error)\n",
      "mean |empirical - optimal|        = 0.1630   (actual policy suboptimality)\n",
      "corr(suboptimality gap, critic grad norm) = 0.236\n"
     ]
