\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Cumulative sample cost of building the CCS with learned successor features as a function of the OLS query, in the Deep Sea Treasure (top) and Office (bottom). All methods recover the same CCS as with exact successor features. (a) Deep Sea Treasure: the agent starts at $s_0$ and each treasure ends the episode. (d) Office: walls in dark grey and the six objects (two coffees C, two offices O and two mail M); episodes start at $s_0$ or at one of the objects. (b, e) Environment steps until convergence. (c, f) All environment steps, including confirming convergence. Mean over 10 seeds, shaded band is $\pm 1$ standard deviation. In Office the variance across seeds is very small, and only the first 20 of the 63 OLS queries of the $\varepsilon $-CCS are shown.}}{16}{figure.1}\protected@file@percent }
\newlabel{fig:ccs_cost}{{1}{16}{Cumulative sample cost of building the CCS with learned successor features as a function of the OLS query, in the Deep Sea Treasure (top) and Office (bottom). All methods recover the same CCS as with exact successor features. (a) Deep Sea Treasure: the agent starts at $s_0$ and each treasure ends the episode. (d) Office: walls in dark grey and the six objects (two coffees C, two offices O and two mail M); episodes start at $s_0$ or at one of the objects. (b, e) Environment steps until convergence. (c, f) All environment steps, including confirming convergence. Mean over 10 seeds, shaded band is $\pm 1$ standard deviation. In Office the variance across seeds is very small, and only the first 20 of the 63 OLS queries of the $\varepsilon $-CCS are shown}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Cumulative sample cost of building the CCS with learned successor features in two stochastic domains, as in Figure~\ref {fig:ccs_cost}. (a) Office, where the chosen action is replaced by one of the other three with probability $0.05$ ($\varepsilon $-CCS with $\varepsilon = 0.05$). (d) Double slit with wind $\pm 1$ and $\gamma = 0.99$ ($\varepsilon = 10^{-3}$): the agent starts at $s_0$ and the exits $O_1$, $O_2$ end the episode. (b, e) Environment steps until convergence. (c, f) All environment steps. Mean over 10 seeds, shaded band is $\pm 1$ standard deviation.}}{17}{figure.2}\protected@file@percent }
\newlabel{fig:ccs_cost_stochastic}{{2}{17}{Cumulative sample cost of building the CCS with learned successor features in two stochastic domains, as in Figure~\ref {fig:ccs_cost}. (a) Office, where the chosen action is replaced by one of the other three with probability $0.05$ ($\varepsilon $-CCS with $\varepsilon = 0.05$). (d) Double slit with wind $\pm 1$ and $\gamma = 0.99$ ($\varepsilon = 10^{-3}$): the agent starts at $s_0$ and the exits $O_1$, $O_2$ end the episode. (b, e) Environment steps until convergence. (c, f) All environment steps. Mean over 10 seeds, shaded band is $\pm 1$ standard deviation}{figure.2}{}}
\abx@aux@cite{0}{kuric_planning_2024}
\abx@aux@segm{0}{0}{kuric_planning_2024}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Double slit domain. (a) Action of the optimal policy for $\mathbf  {w} = (0.5, 0.5)$ at each cell: it keeps both exits open and only commits to one of them at the end, which neither corner policy does. (b) Percentage of the 200 held-out weights where GPI, the metapolicy and $\pi ^{\mathrm  {hyb}}$ are suboptimal, with a basis made of the first $k$ policies found by OLS (exact values). The dotted line marks the two corner policies ($k = 2$).}}{18}{figure.3}\protected@file@percent }
\newlabel{fig:double_slit}{{3}{18}{Double slit domain. (a) Action of the optimal policy for $\mathbf {w} = (0.5, 0.5)$ at each cell: it keeps both exits open and only commits to one of them at the end, which neither corner policy does. (b) Percentage of the 200 held-out weights where GPI, the metapolicy and $\pi ^{\mathrm {hyb}}$ are suboptimal, with a basis made of the first $k$ policies found by OLS (exact values). The dotted line marks the two corner policies ($k = 2$)}{figure.3}{}}
